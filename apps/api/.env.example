# ===== Core =====
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# ===== Replicate =====
REPLICATE_API_TOKEN=r8_your_token_here
# Outside production the model call is mocked unless you opt out, so local
# runs never bill by accident. Set 0 to call the real model. Forbidden in prod.
# REPLICATE_MOCK=0

# ===== Supabase =====
# Use the DEV project. Outside production the api refuses to start if this
# points at the production project.
# Get these at: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...
# Get this at: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ===== Upstash Redis =====

# Get these at: https://console.upstash.com — open your DB → "REST API" tab
# Use the DEV database; the api refuses the production one outside production.
# Keys are prefixed with dev: outside production.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AY...

# Contract tests (optional): the same dev database. Each run uses its own key
# prefix and deletes its keys afterwards.
TEST_UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
TEST_UPSTASH_REDIS_REST_TOKEN=AY...

# NOTE:
# In development you can leave Supabase + Upstash empty — the API falls
# back to a deterministic dev user and an in-memory Redis. Production
# refuses to start without all of the above.
